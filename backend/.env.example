# Бесплатный токен HuggingFace — нужен для pyannote.audio (диаризация).
# Получить: https://huggingface.co/settings/tokens
# Плюс нужно один раз вручную принять условия трёх gated-моделей в своём
# аккаунте HuggingFace (кнопка "Agree and access repository"):
#   pyannote/speaker-diarization-3.1
#   pyannote/segmentation-3.0
#   pyannote/speaker-diarization-community-1
HF_TOKEN=

# Опционально — конфигурация ASR/диаризации, см. app/config.py для остальных
# переменных и значений по умолчанию.
# ASR_DEVICE=cuda
# ASR_MODEL_SIZE=small
# DIARIZATION_DEVICE=cuda

# Прод-БД + аутентификация (Supabase). Оставить пустым для локальной разработки —
# тогда используется SQLite без сети и без логина, как раньше. Заполнить только
# при деплое на Supabase. DATABASE_URL — connection string из Supabase (Settings →
# Database → Connection string → "Session pooler", порт 5432). SUPABASE_URL — URL
# проекта (Settings → API), нужен для проверки JWT через JWKS.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Облачный деплой (Vercel) — CLOUD_MODE=true переключает ASR/диаризацию с
# локального faster-whisper+pyannote на Groq API (бесплатных хостингов не
# хватает по памяти для локальных ML-моделей) и хранение аудио с локального
# диска на Supabase Storage. Live-звонки (WebSocket) в этом режиме недоступны.
# Требует DATABASE_URL и SUPABASE_URL/ANON_KEY выше. Не имеет смысла без них —
# см. docs/architecture.md.
# CLOUD_MODE=true
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# SUPABASE_STORAGE_BUCKET=call-audio
# Service-role ключ (Settings → API → service_role) — только для сервера,
# НИКОГДА не отдаётся фронтенду (в отличие от SUPABASE_ANON_KEY выше). Нужен
# бэкенду для записи/чтения Supabase Storage от имени любого пользователя.
# SUPABASE_SERVICE_ROLE_KEY=
